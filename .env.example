# DeepResearch 环境变量配置示例

# ============================================
# LLM 配置
# ============================================

# LLM 提供商: openai / qwen / custom
LLM_PROVIDER=qwen

# API 密钥
LLM_API_KEY=your-api-key-here

# API 基础 URL（可选）
# Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1 (默认)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（可选）
# Qwen 可选: qwen-turbo, qwen-plus, qwen-max, qwen-long
# OpenAI 可选: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_MODEL=qwen-plus

# ============================================
# 配置示例
# ============================================

# 示例 1: 使用阿里云通义千问 (Qwen)
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxx  # 从 https://dashscope.console.aliyun.com/ 获取
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 示例 2: 使用 OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# 示例 3: 使用其他兼容 OpenAI API 的提供商
# LLM_PROVIDER=custom
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://your-api-endpoint.com/v1
# LLM_MODEL=your-model-name

# ============================================
# Google Search API 配置（SEO 功能，可选）
# ============================================

# Google Custom Search API Key
# 获取地址: https://developers.google.com/custom-search/v1/overview
# 免费配额: 100 次/天
GOOGLE_SEARCH_API_KEY=your-google-api-key-here

# Google Custom Search Engine ID
# 创建地址: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-here

# ============================================
# 其他配置（未来扩展）
# ============================================

# 数据库配置
# DATABASE_URL=sqlite:///./deepresearch.db

# Redis 配置（用于任务队列）
# REDIS_URL=redis://localhost:6379/0

# 日志级别
# LOG_LEVEL=INFO

